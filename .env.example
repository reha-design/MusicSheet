# ==========================================
# MusicSheet Environment Configuration
# ==========================================

# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL 16
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=musicsheet_user
POSTGRES_PASSWORD=musicsheet_password
POSTGRES_DB=musicsheet
DATABASE_URL=postgresql://musicsheet_user:musicsheet_password@localhost:5432/musicsheet

# Redis 7 (Broker & Streams)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Storage
ARTIFACT_STORAGE_TYPE=local
LOCAL_STORAGE_DIR=outputs

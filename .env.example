# ==========================================
# MusicSheet Environment Configuration
# ==========================================

# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL 16
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=musicsheet_user
POSTGRES_PASSWORD=musicsheet_password
POSTGRES_DB=musicsheet
DATABASE_URL=postgresql://musicsheet_user:musicsheet_password@localhost:5432/musicsheet

# Redis 7 (Celery broker / result backend / application event streams)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/2
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Storage
ARTIFACT_STORAGE_TYPE=local
LOCAL_STORAGE_DIR=outputs

# Opt-in TRANSCRIBE provider; install the worker environment before starting workers.
TRANSCRIPTION_PROVIDER=
# TRANSCRIPTION_PROVIDER=basic-pitch
# BASIC_PITCH_PYTHON=D:/develop/MusicSheet/services/ml/basic-pitch-worker/.venv/Scripts/python.exe
# Project-only portable FFmpeg; both settings point to the same absolute ffmpeg.exe.
# FFMPEG_EXECUTABLE is used by model execution; FFMPEG_BIN is used by API diagnostics.
# FFMPEG_EXECUTABLE="C:/path/to/MusicSheet/outputs/tools/ffmpeg/9.0.2/bin/ffmpeg.exe"
# FFMPEG_BIN="C:/path/to/MusicSheet/outputs/tools/ffmpeg/9.0.2/bin/ffmpeg.exe"
# Load explicitly with uv run --env-file .env (the application does not auto-load .env).
